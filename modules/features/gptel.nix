{
  config,
  lib,
  ...
}:

let
  cfg = config.doomemacs;

  modelHintEl =
    if cfg.gptel.defaultModel == null then
      ""
    else
      lib.concatStringsSep "\n" [
        "  ;; Default model hint (define the backend in `gptel.extraConfig'):"
        "  ;; (setq-default gptel-model \"${cfg.gptel.defaultModel}\")"
      ];
in
{
  config = lib.mkIf (cfg.enable && cfg.features.gptel) {
    doomemacs.packages = lib.mkDefault [ { name = "gptel"; } ];

    doomemacs.generatedLisp."+gptel.el" = ''
      ;;; +gptel.el -*- lexical-binding: t; -*-
      ;; Generated by the doomemacs Nix flake.
      ;; gptel base setup only: backends, models, and API keys are left to the
      ;; user config (via `doomemacs.gptel.extraConfig` from the NixOS/HM flake).

      (use-package! gptel
        :commands (gptel
                   gptel-send
                   gptel-menu
                   gptel-add
                   gptel-add-region
                   gptel-rewrite)
        :config
        (setq gptel-expert-commands t)
        ;; Model/backend configuration intentionally left to the user:
        ;; define `gptel-make-*' backends and `gptel-model' below.

${modelHintEl}
        ${cfg.gptel.extraConfig})

      (map! :leader
            (:prefix ("G" . "gptel")
             :desc "Open chat buffer" "g" #'gptel
             :desc "Send prompt" "s" #'gptel-send
             :desc "Gptel menu" "m" #'gptel-menu
             :desc "Add context (file/buffer)" "a" #'gptel-add
             :desc "Add region as context" "r" #'gptel-add-region
             :desc "Rewrite" "w" #'gptel-rewrite))
    '';
  };
}
