{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.doomemacs;
in
{
  config = lib.mkIf (cfg.enable && cfg.features.opencode) {
    # `curl` is required for SSE streaming; the `opencode' CLI is expected on
    # PATH (install OpenCode 2 yourself or via `doomemacs.extraBinPackages`).
    doomemacs.extraBinPackages = lib.mkDefault [ pkgs.curl ];

    doomemacs.generatedLisp."+opencode.el" = ''
      ;;; +opencode.el -*- lexical-binding: t; -*-
      ;; Generated by the doomemacs Nix flake.
      ;; OpenCode client for Emacs (https://github.com/jdormit/emacs-opencode).
      ;; Requires the `opencode' CLI (OpenCode 2) on `PATH', plus `curl' for
      ;; SSE streaming. Session buffers handle their own keybindings (`C-c C-c`
      ;; to send, `C-c C-a` agent, `C-c C-l` model, ...).

      (use-package! emacs-opencode
        :commands (opencode
                   opencode-ask
                   opencode-ask-contextual
                   opencode-open-session
                   opencode-send-to-session
                   opencode-send-context-to-session
                   opencode-mcp-status
                   opencode-disconnect
                   opencode-restart)
        :config
        ;; Personal tweaks go in doomemacs.opencode.extraConfig.
        ${cfg.opencode.extraConfig})

      (map! :leader
            (:prefix "c"
             (:prefix ("A" . "opencode")
              :desc "New session" "n" #'opencode
              :desc "Ask (one-shot)" "a" #'opencode-ask
              :desc "Ask with buffer context" "c" #'opencode-ask-contextual
              :desc "Open existing session" "o" #'opencode-open-session
              :desc "Send prompt to session" "s" #'opencode-send-to-session
              :desc "Send prompt + context" "S" #'opencode-send-context-to-session
              :desc "MCP status" "m" #'opencode-mcp-status
              :desc "Disconnect" "d" #'opencode-disconnect
              :desc "Restart service" "r" #'opencode-restart)))
    '';
  };
}
